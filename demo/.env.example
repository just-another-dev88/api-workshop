# Copy this file to `.env` and change the values.
# NEVER commit your real `.env` file - it is listed in .gitignore.

# Secret key required for POST / PATCH / DELETE (min 8 characters).
# Generate a strong one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-please

# SQLite database file
DATABASE_URL=sqlite:///./todo.db

# Websites allowed to call the API from a browser (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000

# Max requests per client per minute
RATE_LIMIT_PER_MINUTE=60
